<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/loginFragment"
    >
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.surmarket.FragmentLogin"
        android:label="@string/labelLoginFrangment"
        tools:layout="@layout/fragment_login"

        >
        <action
            android:id="@+id/action_login_to_products_list"
            app:destination="@+id/productsListFragment"


            />


    </fragment>

    <fragment
        android:id="@+id/productsListFragment"
        android:name="com.example.surmarket.FragmentProductsList"
        android:label="@string/labelProductsListFragment"
        tools:layout="@layout/fragment_products_list"


        >
        <action
            android:id="@+id/action_products_list_to_add_product"
            app:destination="@+id/AddproductFragment"

            />
        <action
            android:id="@+id/action_products_list_to_cart"
            app:destination="@+id/cartFragment"

            />

    </fragment>
    <fragment
        android:id="@+id/AddproductFragment"
        android:name="com.example.surmarket.FragmentAddProductos"
        android:label="@string/labelAddProductFragment"
        tools:layout="@layout/frangment_add_product"

        >


    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.surmarket.FragmentCart"
        android:label="Carrito"
        tools:layout="@layout/fragment_cart"

        >

    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.surmarket.FragmentProfile"
        android:label="@string/labelProfileFragment"
        tools:layout="@layout/fragment_profile"

        >

    </fragment>
</navigation>